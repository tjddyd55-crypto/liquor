# Railway CRM-liqour / environment: develop
# 실제 secret 은 Railway Service Variables 에만 설정. 이 파일은 키 목록·문서용.

NODE_ENV=production

# PostgreSQL — 같은 프로젝트 Postgres 서비스명이 Postgres 일 때
DATABASE_URL=${{Postgres.DATABASE_URL}}

VITE_API_BASE_PATH=/backend

# 인증 (필수 — Railway 에서 직접 생성·설정)
JWT_SECRET=__SET_IN_RAILWAY__

# R2 — 전자서명 PDF 업로드/완료 저장 (develop 공용 버킷 사용 가능)
R2_ACCOUNT_ID=__SET_IN_RAILWAY__
R2_ACCESS_KEY_ID=__SET_IN_RAILWAY__
R2_SECRET_ACCESS_KEY=__SET_IN_RAILWAY__
R2_BUCKET_NAME=__SET_IN_RAILWAY__
R2_ENDPOINT=__SET_IN_RAILWAY__
R2_PUBLIC_CDN_BASE=__SET_IN_RAILWAY__

# 주류 CRM 테넌트 R2 접두
CRM_R2_OBJECT_ROOT=crm-platform/development/liquor/tenants
APP_PRODUCT=liquor
