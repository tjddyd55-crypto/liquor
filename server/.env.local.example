# 로컬 전용 — 이 파일을 server/.env.local 로 복사해 사용 (gitignore 대상)
# server/.env 의 DATABASE_URL 등을 덮어씁니다.

# 스키마가 이미 Railway/로컬 DB에 적용된 뒤 반복 기동만 빠르게 할 때 (운영·Railway 배포 환경에서는 절대 true 금지)
# INSURANCE_SKIP_INIT_DB=true

# 부트스트랩 admin (최초 1회)
# INSURANCE_ENABLE_ADMIN_BOOTSTRAP=true
# INSURANCE_ADMIN_BOOTSTRAP_USERNAME=admin
# INSURANCE_ADMIN_BOOTSTRAP_PASSWORD=1234
