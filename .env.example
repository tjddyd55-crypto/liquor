JWT_SECRET=change-this-in-production
# 서버 로그 레벨 (pino). 운영 기본 info — log drain에서 trace는 과다할 수 있음
# LOG_LEVEL=info
# PostgreSQL — 로컬 PC에서 import/개발 시: Railway Postgres → Connect → Public Network URL 사용
# (postgres.railway.internal 만 있으면 로컬에서는 ENOTFOUND — 사설 DNS는 클라우드 내부에서만 동작)
# server/db.js 는 server/.env 를 읽고, server/.env.local 이 있으면 덮어씁니다(로컬 전용, gitignore 권장).
# 원격(Railway) DB 로 기동 시 initDb 가 수백 개 DDL 을 순차 실행해 2~3분 걸릴 수 있습니다(멈춘 것이 아님).
# 로컬 postgres 가 있으면 DATABASE_URL 을 localhost 로 두면 훨씬 빠릅니다.
# 스키마가 이미 적용된 로컬 반복 기동: server/.env.local 에 INSURANCE_SKIP_INIT_DB=true (운영/Railway 배포 금지)
DATABASE_PUBLIC_URL=
DATABASE_URL=postgresql://user:password@host:5432/database
# INSURANCE_SKIP_INIT_DB=true
VITE_API_BASE_PATH=/backend

# 비밀번호 재설정·SMS 인증 — 설정 시 Aligo 대신 HTTP 게이트웨이로 POST (JSON: { "phone", "message" })
# 예: EC2 중계 서버 (로그·응답에 URL 노출하지 말 것) — sms-gateway-ec2 참고
# SMS_HTTP_GATEWAY_URL=http://100.54.92.161:3000/send-sms
# 선택: 발송 직전 GET 헬스체크 (게이트웨이에 GET /health 필요). true 면 SMS_HTTP_GATEWAY_URL 의 origin + /health 또는 아래 URL 사용
# SMS_GATEWAY_HEALTH_CHECK=false
# SMS_HTTP_GATEWAY_HEALTH_URL=https://sms.example.com/health
# SMS_GATEWAY_HEALTH_TIMEOUT_MS=2000
# SMS 발송 axios timeout(ms), 기본 5000, 최소 3000·최대 8000으로 클램프
# SMS_SEND_TIMEOUT_MS=5000

# 다중 인스턴스 SMS rate limit·서킷 브레이커 공유 (미설정 시 인메모리 폴백)
# REDIS_URL=redis://default:password@host:6379

# 동의서 PDF — Cloudflare R2 (미설정 시 server-data/consent-storage 로컬 폴더)
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# 공개 CDN(커스텀 도메인 등). 미설정 시 코드 기본값 사용.
# R2_PUBLIC_CDN_BASE=https://cdn.example.com
# 원수사 소식 presigned PUT 시 객체 Cache-Control (기본 public, max-age=31536000)
# R2_INSURER_ATTACHMENTS_CACHE_CONTROL=public, max-age=31536000
# R2 버킷 접두사 insurer/ 30일 라이프사이클은 대시보드에서 설정 — docs/ops/r2-lifecycle-insurer.md
# 한글 텍스트 drawText 시 권장: NotoSansKR-Regular.otf 경로
# CONSENT_FONT_PATH=

# 원수사 연락처 편집: JWT의 role이 staff 또는 super_admin 일 때만 허용됩니다.
# (구) INSURANCE_CONTACT_ADMIN_USERNAME / VITE_INSURANCE_CONTACT_ADMIN_USERNAME 은 더 이상 사용하지 않습니다.

# admin 계정 자동 생성: true 일 때만 기동 시 없으면 INSERT (생성 후 false 권장)
INSURANCE_ENABLE_ADMIN_BOOTSTRAP=true
INSURANCE_ADMIN_BOOTSTRAP_USERNAME=admin
INSURANCE_ADMIN_BOOTSTRAP_PASSWORD=1234

# 정부지원 CRM 최초 관리자 (Railway develop 등 — 1회 생성 후 ENABLED=false 및 PASSWORD 제거 권장)
# GOVERNMENT_ADMIN_BOOTSTRAP_ENABLED=true
# GOVERNMENT_ADMIN_LOGIN_ID=govadmin
# GOVERNMENT_ADMIN_PASSWORD=__SET_IN_RAILWAY__
# GOVERNMENT_ADMIN_NAME=정부지원 CRM 관리자
# GOVERNMENT_ADMIN_RESET_PASSWORD_ON_BOOTSTRAP=false

# ⚠️ 1회만: 모든 users 삭제 후 부트스트랩으로 admin 재생성할 때만 true. 사용 후 반드시 제거.
# INSURANCE_DEBUG_RESET_ALL_USERS=true

# 로그인 시 평문 비밀번호·해시까지 로그 (임시 진단용, 배포 후 끄기)
# INSURANCE_LOGIN_DEBUG=true

# 회원가입 휴대폰: 미설정 또는 0 = 번호 필수·SMS 인증·중복(활성 사용자) 차단. 완화는 1/true/on 만 (로컬 테스트용)
INSURANCE_SIGNUP_PHONE_RELAXED=0
# Vite 프론트 — 서버와 동일하게 유지
VITE_INSURANCE_SIGNUP_PHONE_RELAXED=0
